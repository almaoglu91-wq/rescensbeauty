{%- render 'rescens-assets' -%}

<div class="rescens-scope" id="rescens-how-{{ section.id }}">
  <section class="rs-section rs-warm">
    {%- if section.settings.eyebrow != blank -%}
      <div class="rs-section-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h2 class="rs-section-title">{{ section.settings.title }}</h2>

    {%- for b in section.blocks -%}
      <div class="rs-how-card" {{ b.shopify_attributes }}>
        <span class="rs-how-num">{{ b.settings.num }}</span>
        <div class="rs-how-visual">
          {%- case b.settings.icon -%}
            {%- when 'brush' -%}
              <svg viewBox="0 0 40 40"><path d="M10 30 L30 10 M28 8 L32 12"/><circle cx="30" cy="10" r="2.5"/></svg>
            {%- when 'drop' -%}
              <svg viewBox="0 0 40 40"><path d="M8 25 Q20 12 32 25"/><circle cx="20" cy="28" r="2"/></svg>
            {%- when 'sparkle' -%}
              <svg viewBox="0 0 40 40"><path d="M6 20 L34 20"/><path d="M10 17 L10 23 M18 15 L18 25 M26 17 L26 23 M34 18 L34 22"/></svg>
            {%- when 'star' -%}
              <svg viewBox="0 0 40 40"><polygon points="20,6 24,16 35,17 27,24 29,35 20,29 11,35 13,24 5,17 16,16"/></svg>
            {%- else -%}
              <svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="10"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="rs-how-title">{{ b.settings.title }}</h3>
        <p class="rs-how-body">{{ b.settings.body }}</p>
      </div>
    {%- endfor -%}
  </section>
</div>

{% schema %}
{
  "name": "rescens · how it works",
  "tag": "section",
  "class": "rescens-section-how",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "die routine" },
    { "type": "richtext", "id": "title", "label": "Titel", "default": "<p>drei schritte. <span class=\"rs-accent\">zehn sekunden.</span></p>" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "num", "label": "Nummer/Header", "default": "01 — auftragen" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "brush", "options": [
          { "value": "brush", "label": "Pinsel" },
          { "value": "drop", "label": "Tropfen" },
          { "value": "sparkle", "label": "Funkel" },
          { "value": "star", "label": "Stern" }
        ]},
        { "type": "text", "id": "title", "label": "Titel", "default": "auftragen" },
        { "type": "text", "id": "body", "label": "Beschreibung", "default": "präzisions pinsel am wimpernkranz entlang. wie ein feiner eyeliner. nicht ins auge." }
      ]
    }
  ],
  "presets": [
    {
      "name": "rescens · how it works",
      "category": "rescens",
      "blocks": [
        { "type": "step", "settings": { "num": "01 — auftragen", "icon": "brush", "title": "auftragen", "body": "präzisions pinsel am wimpernkranz entlang. wie ein feiner eyeliner. nicht ins auge." } },
        { "type": "step", "settings": { "num": "02 — einziehen", "icon": "drop", "title": "einziehen lassen", "body": "30 sekunden trocknen. dann normale pflege routine. mascara wie gewohnt morgens." } },
        { "type": "step", "settings": { "num": "03 — sichtbar", "icon": "sparkle", "title": "sichtbar in 8 wochen", "body": "konsistenz schlägt intensität. eine flasche ca. 6 wochen. volle routine 8 bis 12 wochen." } }
      ]
    }
  ]
}
{% endschema %}
